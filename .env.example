# Firebase is OPTIONAL. Leave blank and the game runs fully offline on IndexedDB.
# Fill these to enable Google sign-in + cloud snapshot backup of the Dexie database.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# NOTE: LLM provider keys are NOT read from env. They are entered at runtime in the
# in-game API Config modal and stored in IndexedDB, so a build can be shared safely.
