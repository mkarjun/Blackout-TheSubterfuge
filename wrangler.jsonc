{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "blackout-the-subterfuge",
  "compatibility_date": "2026-08-31",

  // The Worker exists only to relay multiplayer WebSockets (/room/CODE). Every other
  // request is served straight from the static bundle via the ASSETS binding, so the
  // single-player game costs no compute at all.
  "main": "worker/index.js",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  // One Durable Object per room code, addressed with getByName(). SQLite-backed so it
  // runs on the free plan; the object stores nothing, it just holds sockets open.
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RoomRelay" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomRelay"] }
  ],

  "observability": {
    "enabled": true
  }

  // ---------------------------------------------------------------------------
  // CUSTOM DOMAIN - uncomment once mkarjun.com is an active zone in this same
  // Cloudflare account. Wrangler creates the DNS record for you on deploy.
  //
  // Left commented on purpose: if the zone is not in the account, the deploy fails
  // outright rather than falling back, and a failed deploy is a bad way to find
  // that out.
  //
  // "routes": [
  //   { "pattern": "blackout.mkarjun.com", "custom_domain": true }
  // ]
  // ---------------------------------------------------------------------------
}
